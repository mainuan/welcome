# Local CMake/Qt builds and installation staging roots.
/build/
/build-*/
/cmake-build-*/
/obj-*/
/stage/
/dist/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/.qt/
/.rcc/
/*_autogen/

# Local Debian packages and packaging intermediates (keep debian/ sources).
/*.deb
/*.ddeb
/*.changes
/*.buildinfo
/*.build
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/mainuan-welcome/
/debian/mainuan-welcome-dbgsym/
/debian/*.debhelper.log
/debian/*.substvars

# Local tooling caches, not source fixtures or permanent reports.
/.cache/
__pycache__/
*.pyc
