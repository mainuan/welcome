<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.mainuan.Welcome</id>
  <name>Mainuan Welcome</name>
  <summary>Set up Mainuan and get to know the features of your desktop</summary>
  <description>
    <p>Welcome application of the Mainuan desktop. It helps new users choose the look of the desktop, install media codecs, the antivirus, the firewall, office suites and web browsers, and find the video tutorials.</p>
  </description>
  <developer id="org.mainuan">
    <name translate="no">Mainuan</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.1"/>
  <launchable type="desktop-id">org.mainuan.Welcome.desktop</launchable>
  <url type="homepage">https://github.com/mainuan/welcome</url>
  <url type="bugtracker">https://github.com/mainuan/welcome/issues</url>
  <releases>
    <release version="1.0.1" date="2026-10-28" type="stable">
      <description translate="no">
        <p>Recognize inherited Mainuan color schemes at startup and preserve the current color when switching between light and dark modes.</p>
        <p>Use a smaller resizable window and responsive pages, simplify installation indicators, and apply each visual style's installed window decoration.</p>
      </description>
    </release>
    <release version="1.0" date="2026-10-17" type="stable">
      <description translate="no">
        <p>First official Mainuan Welcome release, with native Plasma customization and application installation.</p>
      </description>
    </release>
  </releases>
  <provides>
    <binary>mainuan-welcome</binary>
  </provides>
</component>
