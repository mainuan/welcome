# reviewed: hyphen: proper name + common noun
#: rootfs/usr/share/metainfo/org.mainuan.Welcome.metainfo.xml.in:7
msgid ""
"Welcome application of the Mainuan desktop. It helps new users choose the "
"look of the desktop, install media codecs, the antivirus, the firewall, "
"office suites and web browsers, and find the video tutorials."
msgstr ""
"A Mainuan-asztal üdvözlőalkalmazása. Segít az új felhasználóknak "
"kiválasztani az asztal megjelenését, telepíteni a médiakodekeket, a "
"víruskeresőt, a tűzfalat, irodai csomagokat és webböngészőket, valamint "
"megtalálni a videós útmutatókat."

#: rootfs/usr/share/polkit-1/actions/org.mainuan.welcome.policy.in:9
msgid "Install system components recommended by Mainuan Welcome"
msgstr "A Mainuan Üdvözlő által ajánlott rendszer-összetevők telepítése"

